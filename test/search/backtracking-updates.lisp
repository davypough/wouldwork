(defun test-bt-cycle-data-switching ()
  "The same compiled effect must follow runtime mode changes."
  (let* ((action (find 'later-choice *actions* :key #'action.name))
         (effect (symbol-function (action.eff-defun-name action)))
         (original (symbol-function 'update-set-signature))
         (old-mode *bt-cycle-check*) (calls 0))
    (unwind-protect
        (progn
          (setf (symbol-function 'update-set-signature)
                (lambda (ops) (incf calls) (funcall original ops)))
          (dolist (mode '(immediate path immediate))
            (eval `(ww-set *bt-cycle-check* ,mode))
            (setf calls 0)
            (assert (eq effect (symbol-function (action.eff-defun-name action))))
            (let* ((*backtrack-state* (copy-problem-state *start-state*))
                   (before (bt-update-test-signature *backtrack-state*))
                   (choice (first (generate-choices-for-single-combination-bt action nil t 0))))
              (unwind-protect
                  (progn
                    (assert (choice.forward-update choice))
                    (assert (choice.undo-frame choice))
                    (if (eq mode 'path)
                        (progn (assert (zerop calls))
                               (assert (null (choice.inverse-update choice)))
                               (assert (null (choice.forward-sig choice)))
                               (assert (null (choice.inverse-sig choice))))
                        (progn (assert (= calls 2))
                               (assert (choice.inverse-update choice))
                               (assert (choice.forward-sig choice))
                               (assert (choice.inverse-sig choice)))))
                (restore-choice-database-bt choice))
              (assert (equalp before (bt-update-test-signature *backtrack-state*))))))
      (setf (symbol-function 'update-set-signature) original)
      (eval `(ww-set *bt-cycle-check* ,old-mode)))))

(defun test-bt-update-inverse-contract (literal old-literal)
  "Check standalone inverses and trailed omission against the same mutation."
  (dolist (mode '(immediate path))
    (dolist (trailed '(nil t))
      (let* ((*bt-cycle-check* mode) (*problem-type* 'planning)
             (db (make-hash-table)) (*bt-undo-frame* nil))
        (when old-literal (update db old-literal))
        (let* ((before (copy-idb db))
               (frame (when trailed (begin-bt-undo db)))
               (*bt-undo-frame* frame))
          (unwind-protect
              (multiple-value-bind (forward inverse) (update-bt db literal)
                (assert (equal literal forward))
                (if (and trailed (eq mode 'path))
                    (assert (null inverse))
                    (assert (equal inverse
                                   (if (eq (first literal) 'not) (second literal)
                                       (or old-literal (list 'not literal)))))))
            (when frame (restore-bt-undo frame)))
          (when frame (assert (equalp before db))))))))

(defun test-bt-path-cycle-data ()
  (test-bt-cycle-data-switching)
  (test-bt-update-inverse-contract '(done) nil)
  (test-bt-update-inverse-contract '(not (ready)) '(ready))
  (let ((saved *fluent-relation-indices*))
    (unwind-protect
        (progn
          (setf *fluent-relation-indices* (copy-idb saved)
                (gethash 'ready *fluent-relation-indices*) '(1))
          (test-bt-update-inverse-contract '(ready 2) '(ready 1))
          (test-bt-update-inverse-contract '(ready 2) nil))
      (setf *fluent-relation-indices* saved)))
  (let ((*bt-cycle-check* 'path))
    (test-backtracking-snapshot-generation nil)
    (test-backtracking-snapshot-generation t)
    (test-bt-effect-error-restoration)
    (test-bt-constraint-error-restoration)
    (test-bt-reapplication-error-restoration)
    (test-bt-overlapping-siblings))
  (format t "~&BACKTRACKING-PATH-CYCLE-DATA-CHECKS-PASSED~%"))

