(require :asdf)
(defpackage :ww (:use :cl)) (in-package :ww)
(defun in-src (f) (merge-pathnames f (concatenate 'string (namestring (user-homedir-pathname)) "mnt/wouldwork/src/")))
(load (compile-file (merge-pathnames "ac/cw15code.lisp" (user-homedir-pathname))))
(defun texts-of (pairs)
  (map 'vector (lambda (f) (string-upcase (second (assoc f pairs :test #'string-equal)))) *field-names*))
(defun ac-only (texts)
  ;Initial domains then propagation to a fixpoint: nil if some open field is left empty.
  (let ((domains (initial-domains texts)))
    (and (full-fields-valid texts)
         (loop for d across domains never (and d (zerop (bit-count d))))
         (propagate domains (open-links texts) (open-numbers domains)))))
(defparameter *grids* (with-open-file (s (merge-pathnames "ac/grids15.lisp" (user-homedir-pathname)))
                        (let ((*package* (find-package :ww)))
                          (loop for g = (read s nil) while g collect g))))
(format t "~a grids~%" (length *grids*))
