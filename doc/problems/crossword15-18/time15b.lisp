(in-package :ww)
(let ((h (make-hash-table)))
  (dolist (g *grids*)
    (let* ((texts (texts-of (rest g))) (t0 (get-internal-real-time)))
      (ac-only texts)
      (let ((t1 (get-internal-real-time)))
        (complete-grid texts 2000)
        (let ((e (gethash (first g) h (list 0 0 0))))
          (setf (gethash (first g) h) (list (1+ (first e)) (+ (second e) (- t1 t0)) (+ (third e) (- (get-internal-real-time) t1))))))))
  (maphash (lambda (k v) (format t "~a n=~a  AC ~,1f ms  complete-grid ~,1f ms~%" k (first v)
                                 (/ (second v) (first v) 1000.0) (/ (third v) (first v) 1000.0))) h))
