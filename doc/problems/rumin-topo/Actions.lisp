    (move > agent1* moves via ((stairs location2 (staircase1) location4)
                               (walk location4 nil location13)
                               (stairs location13 (staircase2) location17)))
    (move > agent1 moves via ((walk location1 (gate2) location6)))
    (put-tray > agent1 puts tray1 on plate1 at location6)
    (move > agent1 moves via ((walk location6 (gate3) location7)))
    (pickup-box > agent1 picks up box1 at location7 from location7)
    (move > agent1 moves via ((walk location7 (gate3) location6)
                              (walk location6 (gate2) location1)))
    ;; SG4 under revised SG3: retrieve connector2
    (move > agent1 moves via ((walk location1 nil location11)
                              (walk location11 nil location8)))
    (put-box > agent1 puts box1 on ground at location8)
    (move > agent1 moves via ((walk location8 nil location11)
                              (walk location11 nil location1)
                              (walk location1 (gate2) location6)))
    (pickup-tray > agent1 picks up tray1 at location6 from location6)
    (move > agent1 moves via ((walk location6 (gate2) location1)
                              (walk location1 nil location11)
                              (walk location11 nil location8)))
    (move > agent1 moves via ((jump (location8 ground) nil (location8 box1))))
    (move > agent1 moves via ((jump (location8 box1) (edge4) (location9 ground))))
    (put-tray > agent1 puts tray1 on plate2 at location9)
    (move > agent1 moves via ((stairs location9 (gate4 staircase3) location10)))
    (pickup-connector > agent1 picks up connector2 at location10)
    (move > agent1 moves via ((stairs location10 (gate4 staircase3) location9)
                              (jump location9 (edge4) location8)))
    ;; Accepted recovery check: restore blue using the still-loaded ghost tray
    (move > agent1* moves via ((stairs location17 (staircase2) location13)
                               (walk location13 nil location4)
                               (stairs location4 (staircase1) location2)))
    ;; SG5: live-only blue chain, connector1 on box1 -> connector2
    (move > agent1 moves via ((walk location8 nil location11)
                              (walk location11 nil location1)
                              (walk location1 (gate1) location17)))
    (connect-connector > agent1 connects connector2 on ground to (connector1 receiver1) at location17)
    (move > agent1 moves via ((walk location17 (gate1) location1)
                              (walk location1 nil location11)
                              (walk location11 nil location8)))
    (pickup-box > agent1 picks up box1 at location8 from location8)
    (move > agent1 moves via ((walk location8 nil location11)
                              (walk location11 nil location1)
                              (walk location1 (gate1) location17)
                              (stairs location17 (staircase2) location13)
                              (walk location13 nil location4)
                              (stairs location4 (staircase1) location2)))
    (put-box > agent1 puts box1 on ground at location2)
    (move > agent1 moves via ((stairs location2 (staircase1) location4)))
    (pickup-connector > agent1 picks up connector1 at location4)
    (connect-connector > agent1 connects connector1 on box1 to (connector2 transmitter1) at location2)
    ;; SG6: close cycle 1 with live blue and plate2 preserved
    (put-tray > agent1* puts tray1* on ground at location2)
    (move > agent1* moves via ((walk location2 nil location3)))
    (stop-recorder > agent1* stops the recorder)
    ;; SG7: cycle 2 copied blue holds gate1 while live box moves to location8
    (move > agent1 moves via ((stairs location4 (staircase1) location2)
                              (walk location2 nil location3)))
    (start-recorder > agent1 starts the recorder)
    (move > agent1 moves via ((walk location3 nil location2)
                              (stairs location2 (staircase1) location4)))
    (pickup-connector > agent1 picks up connector1 at location4)
    (put-connector > agent1 puts connector1 on ground without pairings at location4)
    (move > agent1 moves via ((stairs location4 (staircase1) location2)))
    (pickup-box > agent1 picks up box1 at location2 from location2)
    (move > agent1 moves via ((stairs location2 (staircase1) location4)
                              (walk location4 nil location13)
                              (stairs location13 (staircase2) location17)
                              (walk location17 (gate1) location1)
                              (walk location1 nil location11)
                              (walk location11 nil location8)))
    (put-box > agent1 puts box1 on ground at location8)
