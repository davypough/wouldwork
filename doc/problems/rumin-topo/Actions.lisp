;;; rumin-topo -- accepted actions from the original start.
(in-package :ww)

(defparameter *accepted-actions*
  '(;; SG1 first gate1 opening: ghost holds tray1* at location2, connector1 on it
    (start-recorder > agent1 starts the recorder)
    (move > agent1* moves via ((walk location3 nil location2)))
    (pickup-tray > agent1* picks up tray1* at location2 from location2)
    (move > agent1 moves via ((walk location3 nil location2)
                              (stairs location2 (staircase1) location4)
                              (walk location4 nil location13)))
    (pickup-connector > agent1 picks up connector1 at location13)
    (move > agent1 moves via ((walk location13 nil location4)))
    (connect-connector > agent1 connects connector1 on tray1* to (connector1* transmitter1) at location2)
    ;; SG2 carry live tray1 through gate1 to location1
    (move > agent1 moves via ((stairs location4 (staircase1) location2)))
    (pickup-tray > agent1 picks up tray1 at location2 from location2)
    (move > agent1 moves via ((stairs location2 (staircase1) location4)
                              (walk location4 nil location13)
                              (stairs location13 (staircase2) location17)
                              (walk location17 (gate1) location1)))
    ;; SG3 revised: preserve loaded ghost tray while interrupting blue
