<mxfile host="Claude">
  <diagram id="walls" name="intersect external walls (aerial survey)">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- roads outside the walls (a grass strip lies between each road and its wall) -->
        <mxCell id="roadN" value="road (north)" style="rect;fillColor=#E6E6E6;strokeColor=none;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="656" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="roadW" value="road (west)" style="rect;fillColor=#E6E6E6;strokeColor=none;fontColor=#666666;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="28" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="roadS" value="road (south)" style="rect;fillColor=#E6E6E6;strokeColor=none;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="656" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="roofed" value="adjacent roofed domain (pool building)" style="rect;fillColor=#FCE4D6;strokeColor=#C0703C;dashed=1;fontColor=#C0703C;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="702" y="150" width="160" height="380" as="geometry"/>
        </mxCell>
        <!-- external walls -->
        <mxCell id="wN" value="north wall" style="endArrow=none;strokeWidth=4;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="40" y="40" as="sourcePoint"/><mxPoint x="696" y="40" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="wW" value="west wall" style="endArrow=none;strokeWidth=4;labelBackgroundColor=#ffffff;horizontal=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="40" y="40" as="sourcePoint"/><mxPoint x="40" y="580" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="wE" value="east wall (shared)" style="endArrow=none;strokeWidth=4;labelBackgroundColor=#ffffff;horizontal=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="696" y="40" as="sourcePoint"/><mxPoint x="696" y="580" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="wS1" value="south wall" style="endArrow=none;strokeWidth=4;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="40" y="580" as="sourcePoint"/><mxPoint x="285" y="580" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="wS2" value="south wall" style="endArrow=none;strokeWidth=4;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="321" y="580" as="sourcePoint"/><mxPoint x="696" y="580" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="entry" value="entrance (purple curtain)" style="endArrow=none;strokeWidth=4;dashed=1;strokeColor=#9933FF;fontColor=#9933FF;labelBackgroundColor=#ffffff;verticalAlign=top;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="285" y="580" as="sourcePoint"/><mxPoint x="321" y="580" as="targetPoint"/></mxGeometry>
        </mxCell>
        <!-- east wall line continues across both roads -->
        <mxCell id="wEn" value="continues north across road (arch over road)" style="endArrow=none;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="696" y="0" as="sourcePoint"/><mxPoint x="696" y="40" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="wEs" value="" style="endArrow=none;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="696" y="580" as="sourcePoint"/><mxPoint x="696" y="660" as="targetPoint"/></mxGeometry>
        </mxCell>
        <!-- notes -->
        <mxCell id="note" value="Aerial survey 2026-11-11, FOV 61°, top-down; drawn 1 unit = 1 screen px of the high plan view.&#xa;Plan about 656 x 540 px (wall lines, not road edges).&#xa;North wall, east to west: high crenellated section from the NE corner (rounded end cap against the east wall) to a junction with a N-S wall; then beams on piers (open spans? not checked from the side); then a colonnade with barred grates between columns.&#xa;NW corner: grated colonnade on both the north and west sides; grass strip and a tree outside.&#xa;West wall, north to south: grated colonnade; a thick section with a recessed panel on its outer face; a slender wall; then the west side of the SW roofed building.&#xa;South wall: SW building's south colonnade; then the gatehouse front: columns with low balustrades (grates below) and the entrance, a purple curtain between two emitter posts about one doorway wide; then wall to the east wall.  A grass patch (with a tree) separates the south wall from the south road.&#xa;East wall: one continuous wall shared with the roofed domain; its line also crosses both roads.&#xa;Inside the NE corner: a roofed structure (under the big tree).&#xa;Unverified: whether the beams-on-piers stretch of the north wall is open below; wall heights." style="text;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="680" height="190" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
